#!/usr/bin/env bash
# Orb resume: fast read-only health check. No installs here.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

command -v bun >/dev/null 2>&1 || { echo "resume: bun missing from PATH"; exit 1; }
[ -d node_modules ] || { echo "resume: node_modules missing, rerun .agents/setup"; exit 1; }
echo "resume: bun $(bun --version), dependencies present"
